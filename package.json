{
  "name": "crosspet-plus-workspace",
  "version": "1.3.10-plus.6",
  "private": true,
  "description": "Original CrossPet desktop app with a Clawd task, approval and remote service",
  "license": "AGPL-3.0-only",
  "scripts": {
    "postinstall": "node scripts/prepare-desktop.cjs && npm --prefix desktop ci",
    "prepare:desktop": "node scripts/prepare-desktop.cjs",
    "setup": "npm run prepare:desktop && npm --prefix desktop ci",
    "start": "node scripts/start-native.cjs",
    "build:win": "node scripts/build-windows.cjs",
    "build:win:dir": "node scripts/build-windows.cjs --dir",
    "build:service:win": "npm run prepare:desktop && npm --prefix desktop run build:win:dir",
    "build:mac": "node scripts/build-macos.cjs",
    "build:mac:dir": "node scripts/build-macos.cjs --dir",
    "test:mac:bridge": "sh tests/macos_plus_bridge.sh",
    "test:plus": "node --test tests/crosspet_service.test.js tests/macos_plus_build.test.js",
    "audit:original": "python3 scripts/audit-crosspet-original.py",
    "build:mac:upstream": "bash app/build.sh"
  },
  "engines": { "node": ">=22.12.0" }
}
